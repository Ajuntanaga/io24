+static NTSTATUS WINAPI wineusb_metadata_get_speed(void *context, UCHAR *speed)
+{
+    const struct wineusb_ms_os_10_metadata_source *source = context;
+    const struct usb_device *device;
+    UCHAR value;
+
+    if (!source || !speed) return STATUS_INVALID_PARAMETER;
+    device = CONTAINING_RECORD(source, struct usb_device, winusb_metadata);
+
+    EnterCriticalSection(&wineusb_cs);
+    if (device->removed || source->removed)
+    {
+        LeaveCriticalSection(&wineusb_cs);
+        return STATUS_DEVICE_NOT_CONNECTED;
+    }
+    value = device->high_speed ? HighSpeed : LowSpeed;
+    LeaveCriticalSection(&wineusb_cs);
+
+    *speed = value;
+    return STATUS_SUCCESS;
+}
