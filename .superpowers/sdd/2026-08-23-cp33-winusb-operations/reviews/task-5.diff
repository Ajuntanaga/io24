+/***********************************************************************
+ *           WinUsb_GetDescriptor (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetDescriptor(WINUSB_INTERFACE_HANDLE handle, UCHAR type, UCHAR index,
+        USHORT language, PUCHAR buffer, ULONG buffer_length, PULONG transferred)
+{
+    struct acquired_handle acquired;
+    const BYTE *cached;
+    UINT32 length;
+
+    if (!transferred)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    *transferred = 0;
+    if (!buffer)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!acquire_handle(handle, &acquired)) return FALSE;
+    if (acquired.interface_index)
+        return fail_after_release(&acquired, ERROR_INVALID_PARAMETER);
+    if (type != 1 && type != 2)
+        return fail_after_release(&acquired, ERROR_NOT_SUPPORTED);
+    if (index || language)
+        return fail_after_release(&acquired, ERROR_INVALID_PARAMETER);
+    if (!cached_descriptor_region(acquired.root, type, &cached, &length))
+        return fail_after_release(&acquired, ERROR_BAD_DEVICE);
+    if (buffer_length < length)
+        return fail_after_release(&acquired, ERROR_INSUFFICIENT_BUFFER);
+
+    memcpy(buffer, cached, length);
+    *transferred = length;
+    release_handle(&acquired);
+    return TRUE;
+}
+
+/***********************************************************************
+ *           WinUsb_QueryDeviceInformation (winusb.@)
+ */
+BOOL WINAPI WinUsb_QueryDeviceInformation(WINUSB_INTERFACE_HANDLE handle, ULONG type,
+        PULONG buffer_length, PVOID buffer)
+{
+    struct acquired_handle acquired;
+    ULONG capacity;
+
+    if (!buffer_length || !buffer)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    capacity = *buffer_length;
+    if (type != DEVICE_SPEED)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!acquire_handle(handle, &acquired)) return FALSE;
+    if (acquired.interface_index)
+        return fail_after_release(&acquired, ERROR_INVALID_PARAMETER);
+    if (!capacity)
+    {
+        *buffer_length = 1;
+        return fail_after_release(&acquired, ERROR_INSUFFICIENT_BUFFER);
+    }
+
+    *(UCHAR *)buffer = acquired.root->snapshot->speed >= HighSpeed ? 0x03 : 0x01;
+    *buffer_length = 1;
+    release_handle(&acquired);
+    return TRUE;
+}
