+/***********************************************************************
+ *           WinUsb_GetAssociatedInterface (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetAssociatedInterface(WINUSB_INTERFACE_HANDLE handle, UCHAR index,
+        PWINUSB_INTERFACE_HANDLE associated)
+{
+    struct acquired_handle acquired;
+    struct winusb_handle *object;
+    struct winusb_root *root;
+    UINT32 root_index;
+    DWORD error = ERROR_SUCCESS;
+    BOOL published = FALSE;
+
+    if (!associated)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    *associated = NULL;
+    if (!acquire_handle(handle, &acquired)) return FALSE;
+    root = acquired.root;
+
+    if (acquired.interface_index)
+        return fail_after_release(&acquired, ERROR_INVALID_PARAMETER);
+    if (index == 0xff)
+        return fail_after_release(&acquired, ERROR_INVALID_PARAMETER);
+    root_index = (UINT32)index + 1;
+
+    EnterCriticalSection(&root->lock);
+    if (root_index >= root->interface_count) error = ERROR_NO_MORE_ITEMS;
+    else if (root->interface_handles[root_index]) error = ERROR_ALREADY_EXISTS;
+    LeaveCriticalSection(&root->lock);
+    if (error) return fail_after_release(&acquired, error);
+
+    if (!(object = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*object))))
+        return fail_after_release(&acquired, ERROR_NOT_ENOUGH_MEMORY);
+    object->root = root;
+    object->interface_index = root_index;
+
+    EnterCriticalSection(&handle_registry_lock);
+    EnterCriticalSection(&root->lock);
+    if (root->retiring) error = ERROR_INVALID_HANDLE;
+    else if (root->interface_handles[root_index]) error = ERROR_ALREADY_EXISTS;
+    else
+    {
+        object->live = TRUE;
+        root->interface_handles[root_index] = object;
+        ++root->live_handles;
+        ++root->references;
+        list_add_tail(&handle_registry, &object->entry);
+        published = TRUE;
+    }
+    LeaveCriticalSection(&root->lock);
+    LeaveCriticalSection(&handle_registry_lock);
+
+    if (!published)
+    {
+        HeapFree(GetProcessHeap(), 0, object);
+        return fail_after_release(&acquired, error);
+    }
+
+    *associated = object;
+    release_handle(&acquired);
+    return TRUE;
+}
+
+static BOOL cached_descriptor_region(const struct winusb_root *root, UCHAR type,
+        const BYTE **buffer, UINT32 *length)
+{
+    const struct wine_winusb_snapshot *snapshot = root->snapshot;
+    SIZE_T end;
+    UINT32 offset;
+
+    if (!snapshot || root->snapshot_size != snapshot->total_size) return FALSE;
+    if (type == 1)
+    {
+        offset = snapshot->device_offset;
+        *length = snapshot->device_length;
+    }
+    else
+    {
+        offset = snapshot->configuration_offset;
+        *length = snapshot->configuration_length;
+    }
+    if (!range_end(root->snapshot_size, offset, *length, &end)) return FALSE;
+    *buffer = (const BYTE *)snapshot + offset;
+    return TRUE;
+}
