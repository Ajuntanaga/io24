+static struct winusb_handle *find_registered_handle(WINUSB_INTERFACE_HANDLE opaque)
+{
+    struct winusb_handle *candidate;
+
+    LIST_FOR_EACH_ENTRY(candidate, &handle_registry, struct winusb_handle, entry)
+        if ((WINUSB_INTERFACE_HANDLE)candidate == opaque && candidate->live) return candidate;
+    return NULL;
+}
+
+static BOOL acquire_handle(WINUSB_INTERFACE_HANDLE opaque, struct acquired_handle *acquired)
+{
+    struct winusb_handle *handle;
+    struct winusb_root *root;
+
+    EnterCriticalSection(&handle_registry_lock);
+    if (!(handle = find_registered_handle(opaque)))
+    {
+        LeaveCriticalSection(&handle_registry_lock);
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+
+    ++handle->api_references;
+    root = handle->root;
+    EnterCriticalSection(&root->lock);
+    ++root->references;
+    acquired->handle = handle;
+    acquired->root = root;
+    acquired->interface_index = handle->interface_index;
+    LeaveCriticalSection(&root->lock);
+    LeaveCriticalSection(&handle_registry_lock);
+    return TRUE;
+}
+
+static void release_handle(struct acquired_handle *acquired)
+{
+    struct winusb_handle *handle = acquired->handle;
+    struct winusb_root *root = acquired->root;
+
+    EnterCriticalSection(&handle_registry_lock);
+    EnterCriticalSection(&root->lock);
+    --handle->api_references;
+    --root->references;
+    if (root->retiring && !root->references) WakeAllConditionVariable(&root->drained);
+    LeaveCriticalSection(&root->lock);
+    LeaveCriticalSection(&handle_registry_lock);
+}
+
+static BOOL fail_after_release(struct acquired_handle *acquired, DWORD error)
+{
+    release_handle(acquired);
+    SetLastError(error);
+    return FALSE;
+}
