+static BOOL validate_header(const struct wine_winusb_snapshot *snapshot)
+{
+    SIZE_T total = snapshot->total_size, device_end, config_end, interfaces_end, alternates_end, endpoints_end;
+
+    if (snapshot->size != sizeof(*snapshot) || snapshot->version != WINE_WINUSB_ABI_VERSION || snapshot->session ||
+            snapshot->reserved[0] || snapshot->reserved[1] || (snapshot->speed != LowSpeed && snapshot->speed != HighSpeed) ||
+            total < sizeof(*snapshot) || total > sizeof(*snapshot) + 0xffffu ||
+            snapshot->device_length != 18 || snapshot->configuration_length < 9 ||
+            !snapshot->interface_count || !snapshot->alternate_count ||
+            !range_end(total, snapshot->device_offset, snapshot->device_length, &device_end) ||
+            !range_end(total, snapshot->configuration_offset, snapshot->configuration_length, &config_end) ||
+            !array_end(total, snapshot->interfaces_offset, snapshot->interface_count, sizeof(struct wine_winusb_interface_snapshot), &interfaces_end) ||
+            !array_end(total, snapshot->alternates_offset, snapshot->alternate_count, sizeof(struct wine_winusb_alternate_snapshot), &alternates_end) ||
+            !array_end(total, snapshot->endpoints_offset, snapshot->endpoint_count, sizeof(struct wine_winusb_endpoint_snapshot), &endpoints_end)) return FALSE;
+    return snapshot->device_offset == sizeof(*snapshot) && snapshot->configuration_offset == device_end &&
+            snapshot->interfaces_offset == config_end && snapshot->alternates_offset == interfaces_end &&
+            snapshot->endpoints_offset == alternates_end && endpoints_end == total;
+}
+
+static BOOL snapshot_matches_header(const struct wine_winusb_snapshot *snapshot,
+        const struct wine_winusb_snapshot *header)
+{
+    return snapshot->size == header->size && snapshot->version == header->version &&
+            snapshot->speed == header->speed && snapshot->total_size == header->total_size &&
+            snapshot->device_offset == header->device_offset && snapshot->device_length == header->device_length &&
+            snapshot->configuration_offset == header->configuration_offset && snapshot->configuration_length == header->configuration_length &&
+            snapshot->interfaces_offset == header->interfaces_offset && snapshot->interface_count == header->interface_count &&
+            snapshot->alternates_offset == header->alternates_offset && snapshot->alternate_count == header->alternate_count &&
+            snapshot->endpoints_offset == header->endpoints_offset && snapshot->endpoint_count == header->endpoint_count &&
+            !snapshot->reserved[0] && !snapshot->reserved[1];
+}
+
+static BOOL validate_snapshot(const struct wine_winusb_snapshot *snapshot, DWORD bytes,
+        const struct wine_winusb_snapshot *header)
+{
+    const BYTE *base = (const BYTE *)snapshot, *config;
+    SIZE_T total = snapshot->total_size, device_end, config_end, interfaces_end, alternates_end, endpoints_end;
+    UINT32 i, j, configuration_interfaces = 0, configuration_endpoints = 0;
+    const BYTE *raw_cursor;
+    struct wine_winusb_interface_snapshot iface, previous_iface;
+    struct wine_winusb_alternate_snapshot alternate, previous_alternate;
+    struct wine_winusb_endpoint_snapshot endpoint;
+
+    if (bytes != total || !snapshot_matches_header(snapshot, header) || snapshot->size != sizeof(*snapshot) || snapshot->version != WINE_WINUSB_ABI_VERSION ||
+            !snapshot->session || total < sizeof(*snapshot) || snapshot->reserved[0] || snapshot->reserved[1] ||
+            (snapshot->speed != LowSpeed && snapshot->speed != HighSpeed)) return FALSE;
+    if (snapshot->device_length < 18 || snapshot->configuration_length < 9 ||
+            !range_end(total, snapshot->device_offset, snapshot->device_length, &device_end) ||
+            !range_end(total, snapshot->configuration_offset, snapshot->configuration_length, &config_end) ||
+            !array_end(total, snapshot->interfaces_offset, snapshot->interface_count, sizeof(iface), &interfaces_end) ||
+            !array_end(total, snapshot->alternates_offset, snapshot->alternate_count, sizeof(alternate), &alternates_end) ||
+            !array_end(total, snapshot->endpoints_offset, snapshot->endpoint_count, sizeof(endpoint), &endpoints_end)) return FALSE;
+    if (snapshot->device_offset != sizeof(*snapshot) || snapshot->configuration_offset != device_end ||
+            snapshot->interfaces_offset != config_end || snapshot->alternates_offset != interfaces_end ||
+            snapshot->endpoints_offset != alternates_end || endpoints_end != total || !snapshot->interface_count) return FALSE;
+    if (snapshot->device_length != 18 || base[snapshot->device_offset] != 18 || base[snapshot->device_offset + 1] != 1 ||
+            base[snapshot->configuration_offset] != 9 || base[snapshot->configuration_offset + 1] != 2) return FALSE;
+    config = base + snapshot->configuration_offset;
+    if (((UINT32)config[2] | ((UINT32)config[3] << 8)) != snapshot->configuration_length ||
+            config[4] != snapshot->interface_count) return FALSE;
+    for (i = 0; i < snapshot->configuration_length; )
+    {
+        if (config[i] < 2 || config[i] > snapshot->configuration_length - i) return FALSE;
+        if (config[i + 1] == 4)
+        {
+            if (config[i] < 9) return FALSE;
+            ++configuration_interfaces;
+        }
+        if (config[i + 1] == 5)
+        {
+            if (config[i] < 7) return FALSE;
+            ++configuration_endpoints;
+        }
+        i += config[i];
+    }
+    if (configuration_interfaces != snapshot->alternate_count || configuration_endpoints != snapshot->endpoint_count) return FALSE;
+    raw_cursor = config + config[0];
+    for (i = 0; i < snapshot->interface_count; ++i)
+    {
+        const BYTE *interface_descriptor;
+
+        if (!read_record(base, total, snapshot->interfaces_offset, i, &iface, sizeof(iface)) || iface.reserved ||
+                !iface.alternate_count || iface.first_alternate > snapshot->alternate_count ||
+                iface.alternate_count > snapshot->alternate_count - iface.first_alternate) return FALSE;
+        if (!i && iface.first_alternate) return FALSE;
+        if (i)
+        {
+            if (!read_record(base, total, snapshot->interfaces_offset, i - 1, &previous_iface, sizeof(previous_iface)) ||
+                    iface.first_alternate != previous_iface.first_alternate + previous_iface.alternate_count) return FALSE;
+            for (j = 0; j < i; ++j)
+            {
+                if (!read_record(base, total, snapshot->interfaces_offset, j, &previous_iface, sizeof(previous_iface)) ||
+                        iface.interface_number == previous_iface.interface_number) return FALSE;
+            }
+        }
+        for (j = 0; j < iface.alternate_count; ++j)
+        {
+            UINT32 k, alternate_index = iface.first_alternate + j;
+            if (!read_record(base, total, snapshot->alternates_offset, alternate_index, &alternate, sizeof(alternate)) ||
+                    alternate.interface_index != i || alternate.first_endpoint > snapshot->endpoint_count ||
+                    alternate.endpoint_count > snapshot->endpoint_count - alternate.first_endpoint || (!j && alternate.alternate_setting != 0) ||
+                    !next_interface_descriptor(&raw_cursor, config + snapshot->configuration_length, &interface_descriptor) ||
+                    interface_descriptor[2] != iface.interface_number || interface_descriptor[3] != alternate.alternate_setting ||
+                    interface_descriptor[4] != alternate.endpoint_count) return FALSE;
+            if (j)
+            {
+                if (!read_record(base, total, snapshot->alternates_offset, alternate_index - 1, &previous_alternate, sizeof(previous_alternate)) ||
+                        alternate.alternate_setting <= previous_alternate.alternate_setting ||
+                        alternate.first_endpoint != previous_alternate.first_endpoint + previous_alternate.endpoint_count) return FALSE;
+            }
+            else if (!alternate_index && alternate.first_endpoint) return FALSE;
+            else if (alternate_index)
+            {
+                if (!read_record(base, total, snapshot->alternates_offset, alternate_index - 1, &previous_alternate, sizeof(previous_alternate)) ||
+                        alternate.first_endpoint != previous_alternate.first_endpoint + previous_alternate.endpoint_count) return FALSE;
+            }
+            for (k = 0; k < alternate.endpoint_count; ++k)
+            {
+                const BYTE *endpoint_descriptor;
+                UINT32 endpoint_index = alternate.first_endpoint + k;
+                if (!read_record(base, total, snapshot->endpoints_offset, endpoint_index, &endpoint, sizeof(endpoint)) ||
+                        endpoint.alternate_index != alternate_index || !endpoint.pipe_id || endpoint.pipe_id > 0xff ||
+                        endpoint.pipe_type > 3 || !endpoint.maximum_packet_size) return FALSE;
+                if (!find_endpoint_descriptor(interface_descriptor, config + snapshot->configuration_length, k, &endpoint_descriptor) ||
+                        endpoint.pipe_id != endpoint_descriptor[2] || endpoint.pipe_type != (endpoint_descriptor[3] & 3) ||
+                        endpoint.maximum_packet_size != ((UINT32)endpoint_descriptor[4] | ((UINT32)endpoint_descriptor[5] << 8))) return FALSE;
+                for (UINT32 previous = 0; previous < k; ++previous)
+                {
+                    const BYTE *previous_descriptor;
+                    if (!find_endpoint_descriptor(interface_descriptor, config + snapshot->configuration_length, previous, &previous_descriptor) ||
+                            previous_descriptor[2] == endpoint_descriptor[2]) return FALSE;
+                }
+            }
+            if (alternate_index == snapshot->alternate_count - 1 &&
+                    alternate.first_endpoint + alternate.endpoint_count != snapshot->endpoint_count) return FALSE;
+        }
+        if (i == snapshot->interface_count - 1 && iface.first_alternate + iface.alternate_count != snapshot->alternate_count) return FALSE;
+    }
+    return TRUE;
+}
