+static BOOL next_interface_descriptor(const BYTE **cursor, const BYTE *config_end, const BYTE **descriptor)
+{
+    while (*cursor + 2 <= config_end)
+    {
+        const BYTE *current = *cursor;
+
+        if (current[0] < 2 || current + current[0] > config_end) return FALSE;
+        *cursor = current + current[0];
+        if (current[1] == 4)
+        {
+            if (current[0] < 9) return FALSE;
+            *descriptor = current;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static BOOL find_endpoint_descriptor(const BYTE *interface_descriptor, const BYTE *config_end,
+        UINT32 index, const BYTE **descriptor)
+{
+    const BYTE *cursor = interface_descriptor + interface_descriptor[0];
+    UINT32 found = 0;
+
+    while (cursor + 2 <= config_end)
+    {
+        if (cursor[0] < 2 || cursor + cursor[0] > config_end) return FALSE;
+        if (cursor[1] == 4) break;
+        if (cursor[1] == 5 && cursor[0] >= 7)
+        {
+            if (found++ == index)
+            {
+                *descriptor = cursor;
+                return TRUE;
+            }
+        }
+        cursor += cursor[0];
+    }
+    return FALSE;
+}
