+static BOOL range_end(SIZE_T total, UINT32 offset, UINT32 length, SIZE_T *end)
+{
+    if (offset > total || length > total - offset) return FALSE;
+    *end = offset + length;
+    return TRUE;
+}
+
+static BOOL array_end(SIZE_T total, UINT32 offset, UINT32 count, SIZE_T size, SIZE_T *end)
+{
+    SIZE_T length;
+
+    if (count > (SIZE_T)-1 / size) return FALSE;
+    length = (SIZE_T)count * size;
+    if (offset > total || length > total - offset) return FALSE;
+    *end = offset + length;
+    return TRUE;
+}
+
+static BOOL read_record(const BYTE *base, SIZE_T total, UINT32 offset, UINT32 index, void *record, SIZE_T size)
+{
+    SIZE_T start, end;
+
+    if (index > (SIZE_T)-1 / size || offset > (SIZE_T)-1 - index * size) return FALSE;
+    start = offset + index * size;
+    if (!range_end(total, start, size, &end)) return FALSE;
+    memcpy(record, base + start, size);
+    return TRUE;
+}
