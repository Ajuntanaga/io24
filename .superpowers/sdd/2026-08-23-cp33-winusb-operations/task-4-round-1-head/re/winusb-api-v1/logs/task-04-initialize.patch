+BOOL WINAPI WinUsb_Initialize(HANDLE device, PWINUSB_INTERFACE_HANDLE handle)
+{
+    struct wine_winusb_snapshot header, *snapshot;
+    struct winusb_handle *object;
+    struct wine_winusb_request release = {.size = sizeof(release), .version = WINE_WINUSB_ABI_VERSION};
+    DWORD bytes = 0;
+
+    if (!handle) { SetLastError(ERROR_INVALID_PARAMETER); return FALSE; }
+    *handle = NULL;
+    if (!query_file_mode(device)) { SetLastError(ERROR_INVALID_HANDLE); return FALSE; }
+    memset(&header, 0, sizeof(header));
+    if (!submit_request(device, IOCTL_WINE_WINUSB_INITIALIZE, &(struct wine_winusb_request){.size=24,.version=1}, 24, &header, sizeof(header), &bytes, TRUE)) return FALSE;
+    if (bytes != sizeof(header) || !validate_header(&header)) { SetLastError(ERROR_BAD_DEVICE); return FALSE; }
+    if (!(snapshot = HeapAlloc(GetProcessHeap(), 0, header.total_size))) { SetLastError(ERROR_NOT_ENOUGH_MEMORY); return FALSE; }
+    if (!submit_request(device, IOCTL_WINE_WINUSB_INITIALIZE, &(struct wine_winusb_request){.size=24,.version=1}, 24, snapshot, header.total_size, &bytes, FALSE)) goto bad_transport;
+    if (!validate_snapshot(snapshot, bytes, &header)) goto bad_postcommit;
+    if (!(object = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*object)))) goto bad_postcommit_memory;
+    object->magic = WINUSB_HANDLE_MAGIC; object->device = device; object->session = snapshot->session; object->snapshot = snapshot;
+    *handle = object;
     return TRUE;
+bad_postcommit:
+    release.session = snapshot->session;
+    submit_request(device, IOCTL_WINE_WINUSB_RELEASE, &release, sizeof(release), NULL, 0, &bytes, FALSE);
+    HeapFree(GetProcessHeap(), 0, snapshot);
+    SetLastError(ERROR_BAD_DEVICE);
+    return FALSE;
+bad_transport:
+    bytes = GetLastError();
+    HeapFree(GetProcessHeap(), 0, snapshot);
+    SetLastError(bytes);
+    return FALSE;
+bad_postcommit_memory:
+    release.session = snapshot->session;
+    submit_request(device, IOCTL_WINE_WINUSB_RELEASE, &release, sizeof(release), NULL, 0, &bytes, FALSE);
+    HeapFree(GetProcessHeap(), 0, snapshot);
+    SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+    return FALSE;
 }
