+static BOOL submit_request(HANDLE device, DWORD code, void *input, DWORD input_size,
+        void *output, DWORD output_size, DWORD *bytes, BOOL size_query)
+{
+    OVERLAPPED overlapped;
+    HANDLE event;
+    BOOL ret, completed = FALSE;
+    DWORD error = ERROR_SUCCESS, local_bytes = 0;
+
+    memset(&overlapped, 0, sizeof(overlapped));
+    if (!(event = CreateEventW(NULL, TRUE, FALSE, NULL)))
+    {
+        error = GetLastError();
+        SetLastError(error ? error : ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+    overlapped.hEvent = event;
+    if (bytes) *bytes = 0;
+    ret = DeviceIoControl(device, code, input, input_size, output, output_size, &local_bytes, &overlapped);
+    if (!ret) error = GetLastError();
+    if (!ret && error == ERROR_IO_PENDING)
+    {
+        DWORD wait = WaitForSingleObject(event, INFINITE);
+        if (wait != WAIT_OBJECT_0)
+        {
+            error = wait == WAIT_FAILED ? GetLastError() : ERROR_GEN_FAILURE;
+            CloseHandle(event);
+            SetLastError(error);
+            return FALSE;
+        }
+        ret = GetOverlappedResult(device, &overlapped, &local_bytes, FALSE);
+        if (!ret) error = GetLastError();
+        else error = ERROR_SUCCESS;
+        completed = TRUE;
+    }
+    else if (!ret) local_bytes = overlapped.InternalHigh;
+    if (bytes) *bytes = local_bytes;
+    CloseHandle(event);
+    if (size_query)
+    {
+        if (!ret && error == ERROR_INSUFFICIENT_BUFFER && local_bytes == sizeof(struct wine_winusb_snapshot)) return TRUE;
+        SetLastError(error == ERROR_INSUFFICIENT_BUFFER ? ERROR_BAD_DEVICE : (error ? error : ERROR_BAD_DEVICE));
+        return FALSE;
+    }
+    if (ret) return TRUE;
+    SetLastError(error ? error : (completed ? ERROR_BAD_DEVICE : ERROR_GEN_FAILURE));
+    return FALSE;
+}
