+static BOOL query_file_mode(HANDLE device)
+{
+    FILE_MODE_INFORMATION mode;
+    IO_STATUS_BLOCK iosb;
+
+    if (!device || device == INVALID_HANDLE_VALUE) return FALSE;
+    memset(&mode, 0, sizeof(mode));
+    memset(&iosb, 0, sizeof(iosb));
+    if (NtQueryInformationFile(device, &iosb, &mode, sizeof(mode), FileModeInformation) ||
+            iosb.Status || iosb.Information != sizeof(mode)) return FALSE;
+    return !(mode.Mode & (FILE_SYNCHRONOUS_IO_ALERT | FILE_SYNCHRONOUS_IO_NONALERT));
+}
