+    KeAcquireSpinLock(&file->lock, &irql);
+    if (file->outstanding && !--file->outstanding)
+        KeSetEvent(&file->zero_outstanding, IO_NO_INCREMENT, FALSE);
+    KeReleaseSpinLock(&file->lock, irql);
+}
