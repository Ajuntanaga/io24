+/* WinUSB alternate-setting entry point. */
+
+#include "windef.h"
+#include "winbase.h"
+#include "winusb.h"
+#include "wine/winusb.h"
+
+#include "winusb_private.h"
+
+static BOOL snapshot_array(const BYTE *base, SIZE_T total, UINT32 offset, UINT32 count,
+        SIZE_T element_size, const BYTE **array)
+{
+    SIZE_T length;
+
+    if (count > ~(SIZE_T)0 / element_size) return FALSE;
+    length = (SIZE_T)count * element_size;
+    if (offset > total || length > total - offset) return FALSE;
+    *array = base + offset;
+    return TRUE;
+}
+
+static BOOL has_alternate(const struct winusb_root *root, UINT32 interface_index,
+        UCHAR setting)
+{
+    const struct wine_winusb_snapshot *snapshot;
+    const BYTE *base, *interfaces, *alternates;
+    const struct wine_winusb_interface_snapshot *interface;
+    UINT32 i;
+
+    if (!root || !(snapshot = root->snapshot) ||
+            root->snapshot_size < sizeof(*snapshot) ||
+            snapshot->total_size != root->snapshot_size ||
+            interface_index >= snapshot->interface_count) return FALSE;
+    base = (const BYTE *)snapshot;
+    if (!snapshot_array(base, root->snapshot_size, snapshot->interfaces_offset,
+            snapshot->interface_count, sizeof(*interface), &interfaces) ||
+            !snapshot_array(base, root->snapshot_size, snapshot->alternates_offset,
+            snapshot->alternate_count, sizeof(struct wine_winusb_alternate_snapshot),
+            &alternates)) return FALSE;
+    interface = (const struct wine_winusb_interface_snapshot *)interfaces + interface_index;
+    if (interface->first_alternate > snapshot->alternate_count ||
+            interface->alternate_count > snapshot->alternate_count - interface->first_alternate)
+        return FALSE;
+    for (i = 0; i < interface->alternate_count; ++i)
+    {
+        const struct wine_winusb_alternate_snapshot *alternate =
+                (const struct wine_winusb_alternate_snapshot *)alternates +
+                interface->first_alternate + i;
+        if (alternate->interface_index == interface_index &&
+                alternate->alternate_setting == setting) return TRUE;
+    }
+    return FALSE;
+}
+
+BOOL WINAPI WinUsb_SetCurrentAlternateSetting(WINUSB_INTERFACE_HANDLE handle,
+        UCHAR setting)
+{
+    struct acquired_handle acquired;
+    struct wine_winusb_alternate_request request;
+    DWORD bytes = 0;
+
+    if (!winusb_acquire_handle(handle, &acquired)) return FALSE;
+    if (!has_alternate(acquired.root, acquired.interface_index, setting))
+        return winusb_fail_after_release(&acquired, ERROR_INVALID_PARAMETER);
+    memset(&request, 0, sizeof(request));
+    request.request.size = sizeof(request);
+    request.request.version = WINE_WINUSB_ABI_VERSION;
+    request.request.session = acquired.root->session;
+    request.request.interface_index = acquired.interface_index;
+    request.alternate_setting = setting;
+    if (!winusb_submit_request(acquired.root->device, IOCTL_WINE_WINUSB_SET_ALTERNATE,
+            &request, sizeof(request), NULL, 0, &bytes, FALSE))
+        return winusb_fail_after_release(&acquired, GetLastError());
+    winusb_release_handle(&acquired);
+    return TRUE;
+}
