+static HANDLE issue_pipe_token(struct wineusb_pipe_table *table, unsigned char endpoint,
+        USBD_PIPE_TYPE type, unsigned char interface_number, unsigned char alternate,
+        uint32_t generation)
+{
+    unsigned int slot;
+    if (!generation || generation > WINEUSB_PIPE_TOKEN_GENERATION_MAX) return NULL;
+    for (slot = 0; slot < WINEUSB_PIPE_TOKEN_SLOTS; ++slot)
+        if (!table->records[slot].current) break;
+    if (slot == WINEUSB_PIPE_TOKEN_SLOTS) return NULL;
+    table->records[slot] = (struct wineusb_pipe_token){generation, endpoint, type, interface_number, alternate, true};
+    return (HANDLE)(uintptr_t)((generation << 9) | (slot + 1));
+}
+
+static struct wineusb_pipe_token *lookup_pipe_token(struct unix_device *device, HANDLE handle)
+{
+    uintptr_t value = (uintptr_t)handle; unsigned int slot = (value & 0x1ff) - 1;
+    uint32_t generation = value >> 9;
+    if (!(value & 0x1ff) || value > UINT32_MAX || slot >= WINEUSB_PIPE_TOKEN_SLOTS || !generation || !device->pipe_table ||
+            !device->pipe_table->records[slot].current || device->pipe_table->records[slot].generation != generation) return NULL;
+    return &device->pipe_table->records[slot];
+}
+
+static bool pipe_token_is_current(const struct unix_device *device,
+        const struct wineusb_pipe_token *pipe)
+{
+    struct libusb_config_descriptor *config;
+    bool found = false;
+    unsigned int i, j, k;
+    if (!pipe || !device->handle) return false;
+    if (libusb_get_active_config_descriptor(libusb_get_device(device->handle), &config)) return false;
+    {
+        for (i = 0; i < config->bNumInterfaces && !found; ++i)
+            for (j = 0; j < (unsigned int)config->interface[i].num_altsetting && !found; ++j)
+            {
+                const struct libusb_interface_descriptor *alt = &config->interface[i].altsetting[j];
+                if (alt->bInterfaceNumber != pipe->interface_number || alt->bAlternateSetting != pipe->alternate) continue;
+                for (k = 0; k < alt->bNumEndpoints; ++k)
+                {
+                    const struct libusb_endpoint_descriptor *endpoint = &alt->endpoint[k];
+                    USBD_PIPE_TYPE type;
+                    switch (endpoint->bmAttributes & LIBUSB_TRANSFER_TYPE_MASK)
+                    {
+                        case LIBUSB_TRANSFER_TYPE_BULK: type = UsbdPipeTypeBulk; break;
+                        case LIBUSB_TRANSFER_TYPE_INTERRUPT: type = UsbdPipeTypeInterrupt; break;
+                        default: continue;
+                    }
+                    if (endpoint->bEndpointAddress == pipe->endpoint && type == pipe->type) { found = true; break; }
+                }
+            }
+        libusb_free_config_descriptor(config);
+        if (!found) return false;
+    }
+    return device_has_interface(device, pipe->interface_number) &&
+            (!device->function || interface_in_set(device->claimed_interfaces,
+            pipe->interface_number)) && device->pipe_table &&
+            device->pipe_table->alternates[pipe->interface_number] == pipe->alternate;
+}
 
