  "schema": "cp34-doubler-private-reverb-v2",
  "static_conclusions": {
    "architecture": "Doubler/Transformer owns a private reverb-core instance; it uses the same constructor and configurator implementation as block 202 but not block 202's state object or send/return path",
    "boundary": "static structure does not prove physical nonvolatile commit, front-panel recall, audible output, or power-cycle survival",
    "preset_contract": "the device-slot Stat record stores the Doubler class id and on/lows/width/mix; it stores no vrvb, FXA, size, predelay, or hp_freq field",
    "sample_rate": "sample rate is runtime configuration, not a preset-record field; native model configuration rebuilds the private core for the device's current rate, including 96 kHz",
    "save_implication": "store the same active Doubler voicefx mapping in one Stat slot from channel 1's pair and one from channel 2's pair; a separate block-202 reverb or reverb-send write must not be added",
    "shared_settings_limit": "block 201 and model 0 are singletons: on/lows/width/mix is one shared setting set for both lanes, not two independently parameterised per-channel Doubler instances",
    "two_lane_contract": "the device maps both physical input selectors into two processing objects, configures singleton block 201 with two inputs and two outputs, and binds private-core indexes 0 and 1; both hardware inputs can therefore run the same private-reverb state simultaneously"
  },
