+def _is_safe_relative_path(value):
+    if not isinstance(value, str):
+        return False
+    relative = PurePosixPath(value)
+    return not (
+        relative.is_absolute() or value != relative.as_posix()
+        or value in ("", ".") or ".." in relative.parts
+    )
