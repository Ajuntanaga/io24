diff --git a/src/binwalk.rs b/src/binwalk.rs
index 678df95..5cdc09a 100644
--- a/src/binwalk.rs
+++ b/src/binwalk.rs
@@ -19,6 +19,17 @@ use crate::extractors;
 use crate::magic;
 use crate::signatures;
 
+// std::path::absolute was stabilized after Ubuntu 24.04's rustc 1.75.
+// Preserve the needed behavior for this build without canonicalizing the path.
+fn absolute_path<P: AsRef<path::Path>>(value: P) -> std::io::Result<path::PathBuf> {
+    let value = value.as_ref();
+    if value.is_absolute() {
+        Ok(value.to_path_buf())
+    } else {
+        Ok(std::env::current_dir()?.join(value))
+    }
+}
