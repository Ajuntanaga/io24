--- a/dlls/ntdll/tests/reg.c
+++ b/dlls/ntdll/tests/reg.c
@@ -2984,8 +2984,11 @@
 static void test_RtlQueryRegistryValues(void)
 {
     RTL_QUERY_REGISTRY_TABLE query_table[2];
+    OBJECT_ATTRIBUTES attr;
     UNICODE_STRING str;
+    HANDLE key;
     NTSTATUS status;
+    DWORD direct_value;
     unsigned int i;
 
     status = RegSetKeyValueW(HKEY_CURRENT_USER, L"WineTest", L"WindowsDrive", REG_EXPAND_SZ,
@@ -3008,6 +3011,30 @@
                              L"Yellow", sizeof(L"Yellow"));
     ok(status == ERROR_SUCCESS, "Failed to create registry value Color: %lu\n", status);
 
+    InitializeObjectAttributes(&attr, &winetestpath, 0, NULL, NULL);
+    status = pNtOpenKey(&key, KEY_READ, &attr);
+    ok(!status, "Failed to open WineTest key, got %#lx.\n", status);
+    if (!status)
+    {
+        memset(query_table, 0, sizeof(query_table));
+        query_table[0].Name = (WCHAR *)L"MeaningOfLife32";
+        query_table[0].Flags = RTL_QUERY_REGISTRY_DIRECT | RTL_QUERY_REGISTRY_REQUIRED;
+        query_table[0].EntryContext = &direct_value;
+
+        direct_value = 0;
+        status = pRtlQueryRegistryValues(RTL_REGISTRY_HANDLE, (PCWSTR)key, query_table, NULL, NULL);
+        ok(!status, "First handle-relative query failed, got %#lx.\n", status);
+        ok(direct_value == 42, "Expected 42, got %lu.\n", direct_value);
+
+        direct_value = 0;
+        status = pRtlQueryRegistryValues(RTL_REGISTRY_HANDLE, (PCWSTR)key, query_table, NULL, NULL);
+        ok(!status, "Second handle-relative query failed, got %#lx.\n", status);
+        ok(direct_value == 42, "Expected 42, got %lu.\n", direct_value);
+
+        status = pNtClose(key);
+        ok(!status, "Failed to close caller-owned key, got %#lx.\n", status);
+    }
+
     RtlInitUnicodeString(&str, NULL);
     memset(query_table, 0, sizeof(query_table));
     query_table[0].QueryRoutine = NULL;
