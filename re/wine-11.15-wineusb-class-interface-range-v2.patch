+#define WINEUSB_IO24_CLASS_INTERFACE_FLAGS \
+    (USBD_TRANSFER_DIRECTION_IN | USBD_SHORT_TRANSFER_OK)
+
+static inline bool wineusb_io24_class_interface_in_supported(
+        const struct _URB_CONTROL_VENDOR_OR_CLASS_REQUEST *req)
+{
+    return req->Hdr.Length >= sizeof(*req)
+            && req->Hdr.Function == URB_FUNCTION_CLASS_INTERFACE
+            && req->TransferFlags == WINEUSB_IO24_CLASS_INTERFACE_FLAGS
+            && req->TransferBufferLength == 256
+            && !req->RequestTypeReservedBits
+            && req->Request == 0x02
+            && req->Value == 0x0100
+            && req->Index == 0x0500;
+}
