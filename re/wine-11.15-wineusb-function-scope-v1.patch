+static bool function_has_interface(bool function, const unsigned char interfaces[32],
+        uint8_t interface)
+{
+    return !function || (interfaces[interface / 8] & (1u << (interface % 8)));
+}
+
+static bool device_has_interface(const struct unix_device *device, uint8_t interface)
+{
+    return function_has_interface(device->function, device->function_interfaces, interface);
+}
+
+static void device_add_interface(struct unix_device *device, uint8_t interface)
+{
+    device->function_interfaces[interface / 8] |= 1u << (interface % 8);
+    ++device->function_interface_count;
+}
+
+static bool assign_function_range(uint8_t roots[256], const bool present[256],
+        bool grouped[256], uint8_t root, uint8_t count)
+{
+    unsigned int i;
+
+    if (count < 2 || (unsigned int)root + count > 256)
+        return false;
+    for (i = root; i < (unsigned int)root + count; ++i)
+        if (!present[i] || grouped[i]) return false;
+    for (i = root; i < (unsigned int)root + count; ++i)
+    {
+        roots[i] = root;
+        grouped[i] = true;
+    }
+    return true;
+}
+
+static bool assign_audio_function(uint8_t roots[256], const bool present[256],
+        bool grouped[256], uint8_t root, const unsigned char *interfaces,
+        uint8_t interface_count)
+{
+    unsigned int i;
+
+    if (!interface_count || !present[root] || grouped[root]) return false;
+    for (i = 0; i < interface_count; ++i)
+        if (!present[interfaces[i]] || grouped[interfaces[i]]) return false;
+
+    roots[root] = root;
+    grouped[root] = true;
+    for (i = 0; i < interface_count; ++i)
+    {
+        roots[interfaces[i]] = root;
+        grouped[interfaces[i]] = true;
+    }
+    return true;
+}
+
+static bool build_function_roots(libusb_device *device,
+        const struct libusb_config_descriptor *config, uint8_t roots[256],
+        bool present[256])
+{
+    struct libusb_interface_association_descriptor_array *associations = NULL;
+    bool grouped[256] = {0}, found = false;
+    unsigned int i, j;
+    int ret;
+
+    for (i = 0; i < 256; ++i) roots[i] = i;
+    for (i = 0; i < config->bNumInterfaces; ++i)
+    {
+        const struct libusb_interface *interface = &config->interface[i];
+
+        if (interface->num_altsetting > 0)
+            present[interface->altsetting[0].bInterfaceNumber] = true;
+    }
+
+    ret = libusb_get_active_interface_association_descriptors(device, &associations);
+    if (!ret)
+    {
+        for (i = 0; i < (unsigned int)associations->length; ++i)
+        {
+            const struct libusb_interface_association_descriptor *association =
+                    &associations->iad[i];
+
+            if (assign_function_range(roots, present, grouped,
+                    association->bFirstInterface, association->bInterfaceCount))
+                found = true;
+        }
+        libusb_free_interface_association_descriptors(associations);
+    }
+    else if (ret != LIBUSB_ERROR_NOT_FOUND)
+    {
+        WARN("Failed to get interface associations: %s\n", libusb_strerror(ret));
+    }
+
+    for (i = 0; i < config->bNumInterfaces; ++i)
+    {
+        const struct libusb_interface *interface = &config->interface[i];
+
+        for (j = 0; j < (unsigned int)interface->num_altsetting; ++j)
+        {
+            const struct libusb_interface_descriptor *descriptor = &interface->altsetting[j];
+            const unsigned char *cursor = descriptor->extra;
+            size_t remaining = descriptor->extra_length;
+
+            if (descriptor->bInterfaceClass != LIBUSB_CLASS_AUDIO ||
+                    descriptor->bInterfaceSubClass != 1 || descriptor->bInterfaceProtocol != 0)
+                continue;
+
+            while (remaining >= 2)
+            {
+                uint8_t length = cursor[0];
+
+                if (length < 2 || length > remaining) break;
+                if (cursor[1] == 0x24 && length >= 8 && cursor[2] == 1 &&
+                        length >= 8u + cursor[7] &&
+                        assign_audio_function(roots, present, grouped,
+                                descriptor->bInterfaceNumber, cursor + 8, cursor[7]))
+                    found = true;
+                cursor += length;
+                remaining -= length;
+            }
+        }
+    }
+
+    return found;
+}
