+static void append_projected_descriptor(unsigned char *output, size_t output_capacity,
+        size_t *output_length, const unsigned char *descriptor, size_t descriptor_length)
+{
+    size_t copy_length = 0;
+
+    if (*output_length < output_capacity)
+    {
+        copy_length = output_capacity - *output_length;
+        if (copy_length > descriptor_length) copy_length = descriptor_length;
+        memcpy(output + *output_length, descriptor, copy_length);
+    }
+    *output_length += descriptor_length;
+}
+
+static bool project_configuration_descriptor(const struct transfer_ctx *transfer_ctx,
+        const unsigned char *input, size_t input_length, unsigned char *output,
+        size_t output_capacity, size_t *returned_length)
+{
+    size_t offset, projected_length = 0, total_length;
+    bool have_interface = false, include_interface = false;
+
+    if (input_length < LIBUSB_DT_CONFIG_SIZE || input[0] < LIBUSB_DT_CONFIG_SIZE ||
+            input[0] > input_length || input[1] != LIBUSB_DT_CONFIG)
+        return false;
+    total_length = input[2] | ((size_t)input[3] << 8);
+    if (total_length < input[0] || total_length > input_length)
+        return false;
+
+    append_projected_descriptor(output, output_capacity, &projected_length, input, input[0]);
+    offset = input[0];
+    while (offset < total_length)
+    {
+        const unsigned char *descriptor = input + offset;
+        uint8_t length, type;
+        bool include;
+
+        if (total_length - offset < 2) return false;
+        length = descriptor[0];
+        type = descriptor[1];
+        if (length < 2 || length > total_length - offset) return false;
+
+        if (type == LIBUSB_DT_INTERFACE_ASSOCIATION)
+        {
+            unsigned int i;
+
+            if (length < LIBUSB_DT_INTERFACE_ASSOCIATION_SIZE) return false;
+            include = false;
+            for (i = descriptor[2]; i < (unsigned int)descriptor[2] + descriptor[3] && i < 256; ++i)
+                if (function_has_interface(transfer_ctx->function,
+                        transfer_ctx->function_interfaces, i)) include = true;
+            have_interface = false;
+            include_interface = false;
+        }
+        else if (type == LIBUSB_DT_INTERFACE)
+        {
+            if (length < LIBUSB_DT_INTERFACE_SIZE) return false;
+            include_interface = function_has_interface(transfer_ctx->function,
+                    transfer_ctx->function_interfaces, descriptor[2]);
+            have_interface = true;
+            include = include_interface;
+        }
+        else
+        {
+            include = !have_interface || include_interface;
+        }
+
+        if (include)
+            append_projected_descriptor(output, output_capacity, &projected_length,
+                    descriptor, length);
+        offset += length;
+    }
+
+    if (projected_length > UINT16_MAX) return false;
+    if (output_capacity > 2) output[2] = projected_length;
+    if (output_capacity > 3) output[3] = projected_length >> 8;
+    if (output_capacity > 4) output[4] = transfer_ctx->function_interface_count;
+    *returned_length = projected_length < output_capacity ? projected_length : output_capacity;
+    return true;
+}
