 }
 
+#define MS_OS_10_STRING_LENGTH 18
+#define MS_OS_10_COMPAT_HEADER_LENGTH 16
+#define MS_OS_10_COMPAT_FUNCTION_LENGTH 24
+#define MS_OS_10_PROPERTIES_HEADER_LENGTH 10
+#define MS_OS_10_MAX_DESCRIPTOR_LENGTH 4096
+#define MS_OS_10_TIMEOUT_MS 1000
+
+struct ms_os_10_function_metadata
+{
+    uint8_t vendor_code;
+    char compatible_id[WINEUSB_MS_OS_10_ID_SIZE];
+    char sub_compatible_id[WINEUSB_MS_OS_10_ID_SIZE];
+    WCHAR device_interface_guid[WINEUSB_MS_OS_10_GUID_SIZE];
+};
+
+static uint16_t get_u16(const unsigned char *buffer)
+{
+    return buffer[0] | ((uint16_t)buffer[1] << 8);
+}
+
+static uint32_t get_u32(const unsigned char *buffer)
+{
+    return buffer[0] | ((uint32_t)buffer[1] << 8) |
+            ((uint32_t)buffer[2] << 16) | ((uint32_t)buffer[3] << 24);
+}
+
+static bool bytes_are_zero(const unsigned char *buffer, size_t length)
+{
+    size_t i;
+
+    for (i = 0; i < length; ++i)
+        if (buffer[i]) return false;
+    return true;
+}
+
+static bool ms_os_10_id_character(unsigned char value)
+{
+    return (value >= 'A' && value <= 'Z') ||
+            (value >= '0' && value <= '9') || value == '_';
+}
+
+static bool parse_ms_os_10_id(const unsigned char source[8],
+        char destination[WINEUSB_MS_OS_10_ID_SIZE])
+{
+    bool terminated = false;
+    size_t i, length = 0;
+
+    memset(destination, 0, WINEUSB_MS_OS_10_ID_SIZE);
+    for (i = 0; i < 8; ++i)
+    {
+        if (!source[i])
+        {
+            terminated = true;
+            continue;
+        }
+        if (terminated || !ms_os_10_id_character(source[i])) return false;
+        destination[length++] = source[i];
+    }
+    return true;
+}
+
+static bool parse_ms_os_10_string(const unsigned char *buffer, size_t length,
+        uint8_t *vendor_code)
+{
+    static const unsigned char signature[14] =
+        {'M', 0, 'S', 0, 'F', 0, 'T', 0, '1', 0, '0', 0, '0', 0};
+
+    if (length != MS_OS_10_STRING_LENGTH || buffer[0] != MS_OS_10_STRING_LENGTH ||
+            buffer[1] != LIBUSB_DT_STRING || memcmp(buffer + 2, signature, sizeof(signature)) ||
+            buffer[17])
+        return false;
+    *vendor_code = buffer[16];
+    return true;
+}
+
+static bool validate_ms_os_10_compatible_header(const unsigned char *header,
+        size_t *descriptor_length)
+{
+    size_t expected_length;
+
+    *descriptor_length = get_u32(header);
+    expected_length = MS_OS_10_COMPAT_HEADER_LENGTH +
+            (size_t)header[8] * MS_OS_10_COMPAT_FUNCTION_LENGTH;
+    return get_u16(header + 4) == 0x0100 && get_u16(header + 6) == 0x0004 &&
+            bytes_are_zero(header + 9, 7) &&
+            *descriptor_length == expected_length &&
+            *descriptor_length <= MS_OS_10_MAX_DESCRIPTOR_LENGTH;
+}
+
+static bool parse_ms_os_10_compatible_ids(const unsigned char *buffer, size_t length,
+        struct ms_os_10_function_metadata functions[256])
+{
+    bool used_interfaces[256] = {0};
+    size_t descriptor_length, offset;
+    unsigned int i;
+
+    memset(functions, 0, 256 * sizeof(*functions));
+    if (length < MS_OS_10_COMPAT_HEADER_LENGTH ||
+            !validate_ms_os_10_compatible_header(buffer, &descriptor_length) ||
+            descriptor_length != length)
+        return false;
+
+    for (i = 0, offset = MS_OS_10_COMPAT_HEADER_LENGTH; i < buffer[8];
+            ++i, offset += MS_OS_10_COMPAT_FUNCTION_LENGTH)
+    {
+        const unsigned char *section = buffer + offset;
+        unsigned int interface = section[0];
+
+        if (section[1] != 1 || used_interfaces[interface] ||
+                !bytes_are_zero(section + 18, 6) ||
+                !parse_ms_os_10_id(section + 2, functions[interface].compatible_id) ||
+                !parse_ms_os_10_id(section + 10, functions[interface].sub_compatible_id))
+            return false;
+        used_interfaces[interface] = true;
+    }
+    return true;
+}
+
+static bool utf16le_equals_ascii(const unsigned char *buffer, size_t length,
+        const char *ascii)
+{
+    size_t i, expected_length = 2 * (strlen(ascii) + 1);
+
+    if (length != expected_length) return false;
+    for (i = 0; i < expected_length / 2; ++i)
+        if (buffer[2 * i] != (unsigned char)ascii[i] || buffer[2 * i + 1]) return false;
+    return true;
+}
+
+static bool guid_character(unsigned int index, unsigned char value)
+{
+    if (index == 0) return value == '{';
+    if (index == 9 || index == 14 || index == 19 || index == 24) return value == '-';
+    if (index == 37) return value == '}';
+    return (value >= '0' && value <= '9') ||
+            (value >= 'a' && value <= 'f') || (value >= 'A' && value <= 'F');
+}
+
+static bool parse_device_interface_guid(const unsigned char *buffer, size_t length,
+        WCHAR guid[WINEUSB_MS_OS_10_GUID_SIZE])
+{
+    WCHAR parsed[WINEUSB_MS_OS_10_GUID_SIZE];
+    unsigned int i;
+
+    if (length != 2 * WINEUSB_MS_OS_10_GUID_SIZE) return false;
+    for (i = 0; i < WINEUSB_MS_OS_10_GUID_SIZE; ++i)
+    {
+        if (buffer[2 * i + 1]) return false;
+        parsed[i] = buffer[2 * i];
+        if (i + 1 == WINEUSB_MS_OS_10_GUID_SIZE)
+        {
+            if (parsed[i]) return false;
+        }
+        else if (!guid_character(i, parsed[i])) return false;
+    }
+    memcpy(guid, parsed, sizeof(parsed));
+    return true;
+}
+
+static bool parse_ms_os_10_properties(const unsigned char *buffer, size_t length,
+        WCHAR guid[WINEUSB_MS_OS_10_GUID_SIZE])
+{
+    WCHAR parsed_guid[WINEUSB_MS_OS_10_GUID_SIZE] = {0};
+    bool found_guid = false;
+    size_t offset = MS_OS_10_PROPERTIES_HEADER_LENGTH;
+    unsigned int i;
+
+    memset(guid, 0, WINEUSB_MS_OS_10_GUID_SIZE * sizeof(*guid));
+    if (length < MS_OS_10_PROPERTIES_HEADER_LENGTH || get_u32(buffer) != length ||
+            get_u16(buffer + 4) != 0x0100 || get_u16(buffer + 6) != 0x0005)
+        return false;
+
+    for (i = 0; i < get_u16(buffer + 8); ++i)
+    {
+        const unsigned char *section;
+        size_t section_length, name_length, data_length;
+
+        if (length - offset < 14) return false;
+        section = buffer + offset;
+        section_length = get_u32(section);
+        name_length = get_u16(section + 8);
+        if (section_length < 14 || section_length > length - offset ||
+                name_length < 2 || name_length & 1 || 14 + name_length > section_length)
+            return false;
+        data_length = get_u32(section + 10 + name_length);
+        if (data_length != section_length - 14 - name_length) return false;
+
+        if (utf16le_equals_ascii(section + 10, name_length, "DeviceInterfaceGUID"))
+        {
+            if (found_guid || get_u32(section + 4) != 1 ||
+                    !parse_device_interface_guid(section + 14 + name_length,
+                            data_length, parsed_guid))
+                return false;
+            found_guid = true;
+        }
+        offset += section_length;
+    }
+    if (offset != length) return false;
+    if (found_guid) memcpy(guid, parsed_guid, sizeof(parsed_guid));
+    return true;
+}
+
+static int get_ms_os_10_descriptor(libusb_device_handle *handle, uint8_t request_type,
+        uint8_t request, uint16_t value, uint16_t index, unsigned char *buffer,
+        uint16_t length)
+{
+    return libusb_control_transfer(handle, request_type, request, value, index,
+            buffer, length, MS_OS_10_TIMEOUT_MS);
+}
+
+static bool get_ms_os_10_compatible_ids(libusb_device_handle *handle,
+        uint8_t vendor_code, struct ms_os_10_function_metadata functions[256])
+{
+    unsigned char header[MS_OS_10_COMPAT_HEADER_LENGTH], *descriptor;
+    size_t descriptor_length;
+    bool ret;
+
+    if (get_ms_os_10_descriptor(handle, 0xc0, vendor_code, 0, 4, header,
+            sizeof(header)) != sizeof(header) ||
+            !validate_ms_os_10_compatible_header(header, &descriptor_length))
+        return false;
+    if (descriptor_length == sizeof(header))
+        return parse_ms_os_10_compatible_ids(header, sizeof(header), functions);
+    if (!(descriptor = malloc(descriptor_length))) return false;
+    if (get_ms_os_10_descriptor(handle, 0xc0, vendor_code, 0, 4, descriptor,
+            descriptor_length) != descriptor_length)
+        ret = false;
+    else
+        ret = parse_ms_os_10_compatible_ids(descriptor, descriptor_length, functions);
+    free(descriptor);
+    return ret;
+}
+
+static bool get_ms_os_10_properties(libusb_device_handle *handle, uint8_t vendor_code,
+        uint8_t interface, WCHAR guid[WINEUSB_MS_OS_10_GUID_SIZE])
+{
+    unsigned char header[MS_OS_10_PROPERTIES_HEADER_LENGTH], *descriptor;
+    size_t descriptor_length;
+    bool ret;
+
+    if (get_ms_os_10_descriptor(handle, 0xc1, vendor_code, interface << 8, 5,
+            header, sizeof(header)) != sizeof(header))
+        return false;
+    descriptor_length = get_u32(header);
+    if (get_u16(header + 4) != 0x0100 || get_u16(header + 6) != 0x0005 ||
+            descriptor_length < sizeof(header) ||
+            descriptor_length > MS_OS_10_MAX_DESCRIPTOR_LENGTH)
+        return false;
+    if (descriptor_length == sizeof(header))
+        return parse_ms_os_10_properties(header, sizeof(header), guid);
+    if (!(descriptor = malloc(descriptor_length))) return false;
+    if (get_ms_os_10_descriptor(handle, 0xc1, vendor_code, interface << 8, 5,
+            descriptor, descriptor_length) != descriptor_length)
+        ret = false;
+    else
+        ret = parse_ms_os_10_properties(descriptor, descriptor_length, guid);
+    free(descriptor);
+    return ret;
+}
+
+static void discover_ms_os_10(libusb_device_handle *handle,
+        struct ms_os_10_function_metadata functions[256])
+{
+    unsigned char string[MS_OS_10_STRING_LENGTH];
+    uint8_t vendor_code;
+    unsigned int i;
+
+    memset(functions, 0, 256 * sizeof(*functions));
+    if (get_ms_os_10_descriptor(handle, 0x80, LIBUSB_REQUEST_GET_DESCRIPTOR,
+            0x03ee, 0, string, sizeof(string)) != sizeof(string) ||
+            !parse_ms_os_10_string(string, sizeof(string), &vendor_code))
+        return;
+    if (!get_ms_os_10_compatible_ids(handle, vendor_code, functions))
+    {
+        memset(functions, 0, 256 * sizeof(*functions));
+        return;
+    }
+
+    for (i = 0; i < 256; ++i)
+    {
+        if (!functions[i].compatible_id[0]) continue;
+        functions[i].vendor_code = vendor_code;
+    }
+}
