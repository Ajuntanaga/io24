@@ -0,0 +1,90 @@
+/*
+ * Microsoft OS 1.0 compatible-ID formatting for wineusb
+ *
+ * Copyright 2026 the Wine project
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdbool.h>
+#include <string.h>
+
+#include "msos_id.h"
+
+static bool id_character(unsigned char value)
+{
+    return (value >= 'A' && value <= 'Z') ||
+            (value >= '0' && value <= '9') || value == '_';
+}
+
+static bool validate_id(const char source[WINEUSB_MS_OS_10_SOURCE_ID_SIZE],
+        bool required, size_t *length)
+{
+    bool terminated = false;
+    size_t i;
+
+    *length = 0;
+    if (source[WINEUSB_MS_OS_10_SOURCE_ID_SIZE - 1]) return false;
+    for (i = 0; i + 1 < WINEUSB_MS_OS_10_SOURCE_ID_SIZE; ++i)
+    {
+        unsigned char value = source[i];
+
+        if (!value)
+        {
+            terminated = true;
+            continue;
+        }
+        if (terminated || !id_character(value)) return false;
+        ++*length;
+    }
+    return !required || *length;
+}
+
+static WCHAR *append_wide(WCHAR *cursor, const WCHAR *source)
+{
+    while (*source) *cursor++ = *source++;
+    return cursor;
+}
+
+static WCHAR *append_id(WCHAR *cursor, const char *source, size_t length)
+{
+    size_t i;
+
+    for (i = 0; i < length; ++i) *cursor++ = (unsigned char)source[i];
+    return cursor;
+}
+
+bool wineusb_ms_os_10_build_pnp_ids(
+        const char compatible_id[WINEUSB_MS_OS_10_SOURCE_ID_SIZE],
+        const char sub_compatible_id[WINEUSB_MS_OS_10_SOURCE_ID_SIZE],
+        struct wineusb_ms_os_10_pnp_ids *ids)
+{
+    static const WCHAR compatible_prefix[] = L"USB\\MS_COMP_";
+    static const WCHAR sub_compatible_prefix[] = L"&MS_SUBCOMP_";
+    size_t compatible_length, sub_compatible_length;
+    WCHAR *cursor;
+
+    memset(ids, 0, sizeof(*ids));
+    if (!validate_id(compatible_id, true, &compatible_length) ||
+            !validate_id(sub_compatible_id, false, &sub_compatible_length))
+        return false;
+
+    if (sub_compatible_length)
+    {
+        cursor = append_wide(ids->ids[ids->count], compatible_prefix);
+        cursor = append_id(cursor, compatible_id, compatible_length);
+        cursor = append_wide(cursor, sub_compatible_prefix);
+        cursor = append_id(cursor, sub_compatible_id, sub_compatible_length);
+        *cursor = 0;
+        ++ids->count;
+    }
+
+    cursor = append_wide(ids->ids[ids->count], compatible_prefix);
+    cursor = append_id(cursor, compatible_id, compatible_length);
+    *cursor = 0;
+    ++ids->count;
+    return true;
+}
