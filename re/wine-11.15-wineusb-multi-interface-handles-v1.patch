+static NTSTATUS validate_select_configuration(IRP *irp,
+        struct _URB_SELECT_CONFIGURATION *req, unsigned int *interface_count,
+        unsigned int *pipe_count)
+{
+    const size_t request_header_size = offsetof(struct _URB_SELECT_CONFIGURATION, Interface);
+    const size_t interface_header_size = offsetof(USBD_INTERFACE_INFORMATION, Pipes);
+    const unsigned char *cursor, *end;
+    unsigned int interfaces = 0, pipes = 0;
+    const char *reason = "unknown";
+    size_t available = 0, required = 0;
+    ULONG declared_pipes = 0;
+
+    if (req->Hdr.Length < request_header_size)
+    {
+        reason = "short_request_header";
+        available = req->Hdr.Length;
+        required = request_header_size;
+        goto invalid;
+    }
+
+    cursor = (const unsigned char *)&req->Interface;
+    end = (const unsigned char *)req + req->Hdr.Length;
+    while (cursor < end)
+    {
+        const USBD_INTERFACE_INFORMATION *interface;
+        size_t remaining, available_pipes;
+
+        remaining = end - cursor;
+        if (remaining < interface_header_size)
+        {
+            reason = "short_interface_header";
+            available = remaining;
+            required = interface_header_size;
+            goto invalid;
+        }
+
+        interface = (const USBD_INTERFACE_INFORMATION *)cursor;
+        if (interface->Length < interface_header_size)
+        {
+            reason = "short_interface_length";
+            available = interface->Length;
+            required = interface_header_size;
+            goto invalid;
+        }
+        if (interface->Length > remaining)
+        {
+            reason = "interface_length_exceeds_request";
+            available = remaining;
+            required = interface->Length;
+            goto invalid;
+        }
+
+        available_pipes = (interface->Length - interface_header_size) /
+                sizeof(interface->Pipes[0]);
+        if (interface->NumberOfPipes > available_pipes)
+        {
+            reason = "truncated_pipe_array";
+            available = available_pipes;
+            required = interface->NumberOfPipes;
+            declared_pipes = interface->NumberOfPipes;
+            goto invalid;
+        }
+
+        pipes += interface->NumberOfPipes;
+        ++interfaces;
+        cursor += interface->Length;
+    }
+
+    *interface_count = interfaces;
+    *pipe_count = pipes;
+    FIXME("IO24_HANDLE_POPULATION event=validated irp=%p header_length=%u "
+            "interfaces=%u pipes=%u.\n", irp, req->Hdr.Length, interfaces, pipes);
+    return STATUS_SUCCESS;
+
+invalid:
+    FIXME("IO24_HANDLE_POPULATION event=reject irp=%p reason=%s interface_index=%u "
+            "available=%lu required=%lu declared_pipes=%u.\n", irp, reason,
+            interfaces, (unsigned long)available, (unsigned long)required,
+            (unsigned int)declared_pipes);
+    req->Hdr.Status = USBD_STATUS_INVALID_PARAMETER;
+    return STATUS_INVALID_PARAMETER;
+}
