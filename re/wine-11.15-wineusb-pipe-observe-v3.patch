+static void io24_observe_select_configuration(IRP *irp,
+        const struct _URB_SELECT_CONFIGURATION *req, const char *phase)
+{
+    const size_t request_header_size = offsetof(struct _URB_SELECT_CONFIGURATION, Interface);
+    const size_t interface_header_size = offsetof(USBD_INTERFACE_INFORMATION, Pipes);
+    const BYTE *cursor, *end;
+    unsigned int interface_index = 0;
+
+    FIXME("IO24_PIPE_OBSERVE event=select_configuration_header phase=%s irp=%p "
+            "header_length=%u status=%#x configuration_handle=%p.\n",
+            phase, irp, req->Hdr.Length, (unsigned int)req->Hdr.Status,
+            req->ConfigurationHandle);
+
+    if (req->Hdr.Length < request_header_size)
+    {
+        FIXME("IO24_PIPE_OBSERVE event=select_configuration_malformed phase=%s irp=%p "
+                "reason=short_request_header available=%u required=%lu.\n",
+                phase, irp, req->Hdr.Length, (unsigned long)request_header_size);
+        return;
+    }
+
+    cursor = (const BYTE *)&req->Interface;
+    end = (const BYTE *)req + req->Hdr.Length;
+    while (cursor < end)
+    {
+        const USBD_INTERFACE_INFORMATION *iface;
+        size_t remaining = end - cursor, available_pipes;
+        ULONG pipe_count, i;
+
+        if (remaining < interface_header_size)
+        {
+            FIXME("IO24_PIPE_OBSERVE event=select_configuration_malformed phase=%s irp=%p "
+                    "reason=short_interface_header interface_index=%u available=%lu required=%lu.\n",
+                    phase, irp, interface_index, (unsigned long)remaining,
+                    (unsigned long)interface_header_size);
+            return;
+        }
+
+        iface = (const USBD_INTERFACE_INFORMATION *)cursor;
+        if (iface->Length < interface_header_size || iface->Length > remaining)
+        {
+            FIXME("IO24_PIPE_OBSERVE event=select_configuration_malformed phase=%s irp=%p "
+                    "reason=invalid_interface_length interface_index=%u length=%u available=%lu "
+                    "minimum=%lu.\n", phase, irp, interface_index, iface->Length,
+                    (unsigned long)remaining, (unsigned long)interface_header_size);
+            return;
+        }
+
+        available_pipes = (iface->Length - interface_header_size) / sizeof(iface->Pipes[0]);
+        pipe_count = iface->NumberOfPipes < available_pipes
+                ? iface->NumberOfPipes : available_pipes;
+        FIXME("IO24_PIPE_OBSERVE event=select_interface phase=%s irp=%p interface_index=%u "
+                "interface=%u alternate=%u class=%u subclass=%u protocol=%u length=%u "
+                "declared_pipes=%u visible_pipes=%u.\n", phase, irp, interface_index,
+                iface->InterfaceNumber, iface->AlternateSetting, iface->Class,
+                iface->SubClass, iface->Protocol, iface->Length,
+                (unsigned int)iface->NumberOfPipes, (unsigned int)pipe_count);
+
+        for (i = 0; i < pipe_count; ++i)
+        {
+            const USBD_PIPE_INFORMATION *pipe = &iface->Pipes[i];
+            FIXME("IO24_PIPE_OBSERVE event=select_pipe phase=%s irp=%p interface_index=%u "
+                    "pipe_index=%u endpoint=%#x type=%u max_packet=%u interval=%u "
+                    "max_transfer=%u flags=%#x handle=%p.\n", phase, irp, interface_index,
+                    (unsigned int)i, pipe->EndpointAddress, (unsigned int)pipe->PipeType,
+                    pipe->MaximumPacketSize, pipe->Interval, pipe->MaximumTransferSize,
+                    (unsigned int)pipe->PipeFlags, pipe->PipeHandle);
+        }
+
+        if (pipe_count != iface->NumberOfPipes)
+            FIXME("IO24_PIPE_OBSERVE event=select_configuration_malformed phase=%s irp=%p "
+                    "reason=truncated_pipe_array interface_index=%u declared_pipes=%u "
+                    "visible_pipes=%u.\n", phase, irp, interface_index,
+                    (unsigned int)iface->NumberOfPipes, (unsigned int)pipe_count);
+
+        cursor += iface->Length;
+        ++interface_index;
+    }
+}
