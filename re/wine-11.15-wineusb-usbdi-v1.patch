new file mode 100644
--- /dev/null
+++ b/dlls/wineusb.sys/usbdi.c
@@ -0,0 +1,55 @@
+/*
+ * USB bus interface support for wineusb
+ *
+ * Copyright 2026 the Wine project
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <string.h>
+
+#include "usbdi.h"
+
+static const GUID usb_bus_interface_usbdi =
+    {0xb1a96a13, 0x3de0, 0x4574, {0x9b, 0x01, 0xc0, 0x8f, 0xea, 0xb3, 0x18, 0xd6}};
+
+NTSTATUS wineusb_query_usbdi_interface(const GUID *interface_type, USHORT size,
+        USHORT version, INTERFACE *interface, void *context,
+        const struct wineusb_usbdi_routines *routines)
+{
+    struct wineusb_usb_bus_interface_usbdi_v1 *usbdi;
+
+    if (!interface_type || !interface || !routines ||
+            !IsEqualGUID(interface_type, &usb_bus_interface_usbdi))
+        return STATUS_NOT_SUPPORTED;
+
+    if (version != WINEUSB_USB_BUSIF_USBDI_VERSION_1 ||
+            size < sizeof(*usbdi))
+        return STATUS_NOT_SUPPORTED;
+
+    if (!routines->InterfaceReference || !routines->InterfaceDereference ||
+            !routines->GetUSBDIVersion || !routines->QueryBusTime ||
+            !routines->SubmitIsoOutUrb || !routines->QueryBusInformation ||
+            !routines->IsDeviceHighSpeed)
+        return STATUS_NOT_SUPPORTED;
+
+    usbdi = (struct wineusb_usb_bus_interface_usbdi_v1 *)interface;
+    *usbdi = (struct wineusb_usb_bus_interface_usbdi_v1)
+    {
+        sizeof(*usbdi),
+        WINEUSB_USB_BUSIF_USBDI_VERSION_1,
+        context,
+        routines->InterfaceReference,
+        routines->InterfaceDereference,
+        routines->GetUSBDIVersion,
+        routines->QueryBusTime,
+        routines->SubmitIsoOutUrb,
+        routines->QueryBusInformation,
+        routines->IsDeviceHighSpeed,
+    };
+    routines->InterfaceReference(context);
+    return STATUS_SUCCESS;
+}
diff --git a/dlls/wineusb.sys/usbdi.h b/dlls/wineusb.sys/usbdi.h
new file mode 100644
--- /dev/null
+++ b/dlls/wineusb.sys/usbdi.h
@@ -0,0 +1,62 @@
+/*
+ * USB bus interface support for wineusb
+ *
+ * Copyright 2026 the Wine project
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef __WINE_WINEUSB_USBDI_H
+#define __WINE_WINEUSB_USBDI_H
+
+#include "ntstatus.h"
+#include "windef.h"
+#include "winternl.h"
+#include "ddk/wdm.h"
+#include "ddk/usb.h"
+
+#define WINEUSB_USB_BUSIF_USBDI_VERSION_1 1
+
+typedef void (WINAPI *wineusb_usbdi_get_version)(void *context,
+        USBD_VERSION_INFORMATION *version, ULONG *capabilities);
+typedef NTSTATUS (WINAPI *wineusb_usbdi_query_bus_time)(void *context,
+        ULONG *current_frame);
+typedef NTSTATUS (WINAPI *wineusb_usbdi_submit_iso_out_urb)(void *context,
+        URB *urb);
+typedef NTSTATUS (WINAPI *wineusb_usbdi_query_bus_information)(void *context,
+        ULONG level, void *buffer, ULONG *buffer_length, ULONG *actual_length);
+typedef BOOLEAN (WINAPI *wineusb_usbdi_is_device_high_speed)(void *context);
+
+struct wineusb_usb_bus_interface_usbdi_v1
+{
+    USHORT Size;
+    USHORT Version;
+    void *BusContext;
+    PINTERFACE_REFERENCE InterfaceReference;
+    PINTERFACE_DEREFERENCE InterfaceDereference;
+    wineusb_usbdi_get_version GetUSBDIVersion;
+    wineusb_usbdi_query_bus_time QueryBusTime;
+    wineusb_usbdi_submit_iso_out_urb SubmitIsoOutUrb;
+    wineusb_usbdi_query_bus_information QueryBusInformation;
+    wineusb_usbdi_is_device_high_speed IsDeviceHighSpeed;
+};
+
+struct wineusb_usbdi_routines
+{
+    PINTERFACE_REFERENCE InterfaceReference;
+    PINTERFACE_DEREFERENCE InterfaceDereference;
+    wineusb_usbdi_get_version GetUSBDIVersion;
+    wineusb_usbdi_query_bus_time QueryBusTime;
+    wineusb_usbdi_submit_iso_out_urb SubmitIsoOutUrb;
+    wineusb_usbdi_query_bus_information QueryBusInformation;
+    wineusb_usbdi_is_device_high_speed IsDeviceHighSpeed;
+};
+
+NTSTATUS wineusb_query_usbdi_interface(const GUID *interface_type, USHORT size,
+        USHORT version, INTERFACE *interface, void *context,
+        const struct wineusb_usbdi_routines *routines);
+
+#endif /* __WINE_WINEUSB_USBDI_H */
