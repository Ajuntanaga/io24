     DEVICE_OBJECT *device_obj;
 
-    bool interface;
+    bool interface, high_speed;
     int16_t interface_index;
 
     uint8_t class, subclass, protocol, busnum, portnum;
@@ -139,6 +140,7 @@ static void add_unix_device(const struct usb_add_device_event *event)
     device->product = event->product;
     device->revision = event->revision;
     device->usbver = event->usbver;
+    device->high_speed = event->high_speed;
 
     EnterCriticalSection(&wineusb_cs);
     list_add_tail(&device_list, &device->entry);
@@ -455,6 +457,68 @@ static void remove_pending_irps(struct usb_device *device)
     }
 }
 
+static void WINAPI usbdi_reference(void *context)
+{
+    TRACE("context %p.\n", context);
+}
+
+static void WINAPI usbdi_dereference(void *context)
+{
+    TRACE("context %p.\n", context);
+}
+
+static void WINAPI usbdi_get_version(void *context,
+        USBD_VERSION_INFORMATION *version, ULONG *capabilities)
+{
+    const struct usb_device *device = context;
+
+    if (version)
+    {
+        version->USBDI_Version = 0x600;
+        version->Supported_USB_Version = device->usbver;
+    }
+    if (capabilities) *capabilities = 0;
+}
+
+static NTSTATUS WINAPI usbdi_query_bus_time(void *context, ULONG *current_frame)
+{
+    TRACE("context %p, current_frame %p: not supported.\n", context, current_frame);
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS WINAPI usbdi_submit_iso_out_urb(void *context, URB *urb)
+{
+    TRACE("context %p, urb %p: not supported.\n", context, urb);
+    return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS WINAPI usbdi_query_bus_information(void *context, ULONG level,
+        void *buffer, ULONG *buffer_length, ULONG *actual_length)
+{
+    TRACE("context %p, level %lu, buffer %p, buffer_length %p: not supported.\n",
+            context, level, buffer, buffer_length);
+    if (actual_length) *actual_length = 0;
+    return STATUS_NOT_SUPPORTED;
+}
+
+static BOOLEAN WINAPI usbdi_is_device_high_speed(void *context)
+{
+    const struct usb_device *device = context;
+
+    return device->high_speed;
+}
+
+static const struct wineusb_usbdi_routines usbdi_routines =
+{
+    usbdi_reference,
+    usbdi_dereference,
+    usbdi_get_version,
+    usbdi_query_bus_time,
+    usbdi_submit_iso_out_urb,
+    usbdi_query_bus_information,
+    usbdi_is_device_high_speed,
+};
+
