diff -urN a/dlls/wineusb.sys/winusb_busif.c b/dlls/wineusb.sys/winusb_busif.c
--- a/dlls/wineusb.sys/winusb_busif.c	1969-12-31 16:00:00.000000000 -0800
+++ b/dlls/wineusb.sys/winusb_busif.c	2026-08-23 03:34:26.692187819 -0700
@@ -0,0 +1,68 @@
+/*
+ * Private WinUSB metadata bus interface for wineusb
+ *
+ * Copyright 2026 the Wine project
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <string.h>
+
+#include "winusb_busif.h"
+
+static const GUID metadata_interface =
+        WINEUSB_MS_OS_10_METADATA_INTERFACE_INIT;
+
+NTSTATUS wineusb_ms_os_10_get_device_interface_guid(
+        const struct wineusb_ms_os_10_metadata_source *source, GUID *guid)
+{
+    static const char winusb_id[WINEUSB_MS_OS_10_SOURCE_ID_SIZE] = "WINUSB";
+    UNICODE_STRING string;
+    GUID parsed;
+    NTSTATUS status;
+
+    if (!source || !guid || source->removed ||
+            memcmp(source->compatible_id, winusb_id, sizeof(winusb_id)) ||
+            source->device_interface_guid[WINEUSB_MS_OS_10_GUID_SIZE - 1])
+        return STATUS_NOT_SUPPORTED;
+
+    RtlInitUnicodeString(&string, source->device_interface_guid);
+    if (string.Length != 38 * sizeof(WCHAR) ||
+            (status = RtlGUIDFromString(&string, &parsed)))
+        return STATUS_NOT_SUPPORTED;
+
+    *guid = parsed;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS wineusb_query_ms_os_10_metadata_interface(const GUID *interface_type,
+        USHORT size, USHORT version, INTERFACE *interface, void *context,
+        const struct wineusb_ms_os_10_metadata_routines *routines)
+{
+    struct wineusb_ms_os_10_metadata_interface_v1 *metadata;
+
+    if (!interface_type || !interface || !context || !routines ||
+            !IsEqualGUID(interface_type, &metadata_interface))
+        return STATUS_NOT_SUPPORTED;
+
+    if (version != WINEUSB_MS_OS_10_METADATA_VERSION_1 ||
+            size < sizeof(*metadata) || !routines->InterfaceReference ||
+            !routines->InterfaceDereference || !routines->GetDeviceInterfaceGuid)
+        return STATUS_NOT_SUPPORTED;
+
+    metadata = (struct wineusb_ms_os_10_metadata_interface_v1 *)interface;
+    *metadata = (struct wineusb_ms_os_10_metadata_interface_v1)
+    {
+        sizeof(*metadata),
+        WINEUSB_MS_OS_10_METADATA_VERSION_1,
+        context,
+        routines->InterfaceReference,
+        routines->InterfaceDereference,
+        routines->GetDeviceInterfaceGuid,
+    };
+    routines->InterfaceReference(context);
+    return STATUS_SUCCESS;
+}
diff -urN a/dlls/wineusb.sys/winusb_busif.h b/dlls/wineusb.sys/winusb_busif.h
--- a/dlls/wineusb.sys/winusb_busif.h	1969-12-31 16:00:00.000000000 -0800
+++ b/dlls/wineusb.sys/winusb_busif.h	2026-08-23 03:34:26.586188541 -0700
@@ -0,0 +1,62 @@
+/*
+ * Private WinUSB metadata bus interface for wineusb
+ *
+ * Copyright 2026 the Wine project
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef __WINE_WINEUSB_WINUSB_BUSIF_H
+#define __WINE_WINEUSB_WINUSB_BUSIF_H
+
+#include "ntstatus.h"
+#include "windef.h"
+#include "winternl.h"
+#include "ddk/wdm.h"
+
+#include "msos_id.h"
+
+#define WINEUSB_MS_OS_10_GUID_SIZE 39
+#define WINEUSB_MS_OS_10_METADATA_VERSION_1 1
+#define WINEUSB_MS_OS_10_METADATA_INTERFACE_INIT \
+    {0xa6523832, 0x2ca5, 0x42ff, {0xaa, 0x70, 0xc7, 0x60, 0xf0, 0x6a, 0x8e, 0x73}}
+
+struct wineusb_ms_os_10_metadata_source
+{
+    char compatible_id[WINEUSB_MS_OS_10_SOURCE_ID_SIZE];
+    char sub_compatible_id[WINEUSB_MS_OS_10_SOURCE_ID_SIZE];
+    WCHAR device_interface_guid[WINEUSB_MS_OS_10_GUID_SIZE];
+    BOOL removed;
+};
+
+typedef NTSTATUS (WINAPI *wineusb_get_device_interface_guid)(void *context,
+        GUID *guid);
+
+struct wineusb_ms_os_10_metadata_interface_v1
+{
+    USHORT Size;
+    USHORT Version;
+    void *BusContext;
+    PINTERFACE_REFERENCE InterfaceReference;
+    PINTERFACE_DEREFERENCE InterfaceDereference;
+    wineusb_get_device_interface_guid GetDeviceInterfaceGuid;
+};
+
+struct wineusb_ms_os_10_metadata_routines
+{
+    PINTERFACE_REFERENCE InterfaceReference;
+    PINTERFACE_DEREFERENCE InterfaceDereference;
+    wineusb_get_device_interface_guid GetDeviceInterfaceGuid;
+};
+
+NTSTATUS wineusb_ms_os_10_get_device_interface_guid(
+        const struct wineusb_ms_os_10_metadata_source *source, GUID *guid);
+
+NTSTATUS wineusb_query_ms_os_10_metadata_interface(const GUID *interface_type,
+        USHORT size, USHORT version, INTERFACE *interface, void *context,
+        const struct wineusb_ms_os_10_metadata_routines *routines);
+
+#endif /* __WINE_WINEUSB_WINUSB_BUSIF_H */
