diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -2940,7 +2940,21 @@ PMDL WINAPI MmAllocatePagesForMdl(PHYSICAL_ADDRESS lowaddress, PHYSICAL_ADDRESS
  */
 void WINAPI MmBuildMdlForNonPagedPool(MDL *mdl)
 {
-    FIXME("stub: %p\n", mdl);
+    PFN_NUMBER *pages = (PFN_NUMBER *)(mdl + 1);
+    ULONG page_count, i;
+    char *base;
+
+    TRACE("%p\n", mdl);
+
+    mdl->Process = NULL;
+    mdl->MappedSystemVa = (char *)mdl->StartVa + mdl->ByteOffset;
+    page_count = ADDRESS_AND_SIZE_TO_SPAN_PAGES(mdl->MappedSystemVa, mdl->ByteCount);
+    base = mdl->StartVa;
+
+    for (i = 0; i < page_count; ++i)
+        pages[i] = (PFN_NUMBER)((ULONG_PTR)(base + i * PAGE_SIZE) >> PAGE_SHIFT);
+
+    mdl->MdlFlags |= MDL_SOURCE_IS_NONPAGED_POOL;
 }
 
