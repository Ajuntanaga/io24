  printf '# Evidence snapshot\n\n'
  printf 'Created: %s\n\n' "$snapshot_time"
  printf 'Refreshed by `refresh-claude-peer-evidence` from the live io24 tree and the\n'
  printf 'five explicitly authorized historical Claude records. `EVIDENCE.sha256`\n'
  printf 'contains %s sorted entries relative to this directory. Evidence directories\n' \
    "${#evidence_files[@]}"
  printf 'are mode `0555` and files are mode `0444`. The peer must bind every finding\n'
  printf 'to this timestamp and manifest; the live tree remains outside its root.\n'
} > "$peer_root/SNAPSHOT.md"

find "$peer_root/evidence" -type f -exec chmod 0444 {} +
find "$peer_root/evidence" -type d -exec chmod 0555 {} +

(
  cd "$peer_root"
  sha256sum -c EVIDENCE.sha256
)
